# EmailJS — https://dashboard.emailjs.com/admin
# The contact form reads these at build time (NEXT_PUBLIC_*) in local `.env.local`
# and in Netlify Environment Variables for production. Leave them empty here
# and the form renders normally but reports that sending is unavailable.
# Note: Keep "Use Private Key" disabled in EmailJS -> Account -> Security when
# sending directly from the browser via `@emailjs/browser`.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
